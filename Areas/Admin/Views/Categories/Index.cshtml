@model IEnumerable<Lab_BE1_2_25DH190025.Models.Category>

@{
    ViewBag.Title = "Index";
    Layout = "/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<h2 class="bg-success">DANH SÁCH DANH MỤC</h2>

@*<p>
    @Html.ActionLink("Thêm Mới", "Create",null,new { @class = "btn btn-primary"})
</p>*@
<table class="table bg-success col-md-6">
    <tr>
        <th class="bg-success col-md-4">
            @*Html.DisplayNameFor(model => model.CategoryName)*@ 
            Tên danh mục
        </th>
        <th class="bg-success col-md-2"></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.CategoryName)
        </td>
        <td>
            @Html.ActionLink("Sửa", "Edit", new { id = item.CategoryID },new {@class="btn btn-promary btn-sm"})
            @Html.ActionLink("Chi tiết", "Details", new { id = item.CategoryID }, new { @class = "btn btn-promary btn-sm" })
            @Html.ActionLink("Xóa", "Delete", new { id = item.CategoryID }, new { @class = "btn btn-promary btn-sm" })
        </td>
    </tr>
}

</table>
<p>
    @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary btn-sm" })
</p>
