@*SẼ ĐC TRUYỀN GIỮA TRANG PARTIAL VIEW VÀ TRANG CHA *@
@model Lab_BE1_2_25DH190025.Models.Category

@*FORM CON SẼ ĐC NHÚNG VÀO FORM CHA LÀ THẰNG EDIT.CSHTML VÀ CREATE.CSHTML *@
<div class="form-group">
    @*Html.LabelFor(model => model.CategoryName, htmlAttributes: new { @class = "control-label col-md-2" })*@
    <div class="control-label col-md-2">Tên Danh Mục</div>
    <div class="col-md-10">
        @Html.EditorFor(model => model.CategoryName, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.CategoryName, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group">
    <div class="col-md-offset-2 col-md-10">
        <input type="submit" value="Save" class="btn btn-default" />
   
        @Html.ActionLink("Quay lại Danh sách", "Index", null, new { @class = "btn btn-primary btn-sm" })
    </div>
</div>
