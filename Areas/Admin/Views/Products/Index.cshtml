@model IEnumerable<Lab_BE1_2_25DH190025.Models.Product>

@{
    ViewBag.Title = "Index";
    Layout = "/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}
<head>
    <style>
        img {
            height: 150px;
            max-width: 100px;
        }
    </style>
</head>
<h2 class="bg-success">Danh sách sản phẩm</h2>

<table class="table bg-info">
    <tr>
        <th class="bg-success col-lg-3"> Tên sản phẩm </th>
        <th class="bg-success col-lg-2"> Hình ảnh </th>
        <th class="bg-success col-lg-1"> Đơn giá </th>
        <th class="bg-success col-lg-2"> Danh mục </th>
        <th class="bg-success col-lg-4"></th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td> @Html.DisplayFor(modelItem => item.ProductName) </td>
            <td> <img src="@Html.DisplayFor(modelItem => item.ProductImage)" /> </td>
            <td> @Html.DisplayFor(modelItem => item.ProductPrice) </td>
            <td> @Html.DisplayFor(modelItem => item.Category.CategoryName) </td>
            <td>
                @Html.ActionLink("SỮA", "Edit", new { id = item.ProductID }, new { @class = "btn btn-promary btn-sm" }) |
                @Html.ActionLink("CHI TIẾT", "Details", new { id = item.ProductID }, new { @class = "btn btn-promary btn-sm" }) |
                @Html.ActionLink("XÓA", "Delete", new { id = item.ProductID }, new { @class = "btn btn-promary btn-sm" })
            </td>
        </tr>
    }

</table>
<p>
    @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary" })
</p>
